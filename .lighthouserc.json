{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "startServerCommand": "python3 -m http.server 4173 --directory out",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/docs/components/",
        "http://localhost:4173/docs/custom/"
      ],
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }]
      }
    }
  }
}
