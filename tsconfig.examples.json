{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    // The examples run on a terminal runtime, not in a browser, so the timer
    // globals the components use come from Node's typings rather than DOM's.
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/react",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["examples/**/*.tsx", "examples/**/*.ts"]
}
